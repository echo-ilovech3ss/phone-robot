# Python 3.11+. From repository root: python -m server
# Environment only: copy this file to server/.env, fill values, then export them
# with: set -a; . server/.env; set +a
# Do not commit .env. Secrets are intentionally blank; no demo credentials work.
ANTHROPIC_API_KEY=
# Required: choose a model available in your Anthropic account. No guessed default.
# Prefer a fast text model appropriate for 256-token voice replies.
ANTHROPIC_MODEL=
# Generate a random token, e.g. python -c 'import secrets; print(secrets.token_urlsafe(32))'
ROBOT_API_TOKEN=

# Deploy exactly ONE worker and ONE replica. Limits are process-local, reset on
# restart, and use fixed windows (a boundary can permit two adjacent bursts).
# Per-token limit applies to the single configured ROBOT_API_TOKEN; no token map.
# Global limit caps authenticated chat. Separate buckets with this same limit
# cap public/bad-auth requests and health, so bad auth cannot spend chat quota.
# Use reverse-proxy ingress limits as well; this is not a network DoS defense.
ROBOT_TOKEN_LIMIT=10
ROBOT_GLOBAL_LIMIT=120
ROBOT_RATE_WINDOW_SECONDS=60
ROBOT_PROVIDER_TIMEOUT_SECONDS=20
ROBOT_BODY_TIMEOUT_SECONDS=10
ROBOT_MAX_BODY_BYTES=16384

# Keep loopback and terminate HTTPS at a reverse proxy. The Android app requires
# HTTPS. Do not enable proxy prompt/header/body logging or request-body tracing.
# The entrypoint disables access logs, fixes workers=1, and caps concurrency=32.
ROBOT_HOST=127.0.0.1
ROBOT_PORT=8000

# Only text is sent upstream; this server never stores conversation history.
# Provider data retention is governed by your Anthropic account's API policy.
# No tools or hardware actions are available. Never interpret replies as commands.
# Zero SDK/application retries; a timeout does NOT guarantee no provider charge.
